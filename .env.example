# Data Plane Configuration
DATABASE_URL=postgresql+asyncpg://nucleus:nucleus_secret@localhost:5432/nucleus_db
REDIS_URL=redis://localhost:6379/0

# BYO-LLM Configuration (Customer's Proxy or OpenAI Direct)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-demo-key-change-me
LLM_MODEL=gpt-4o-mini

# Embeddings Engine Configuration (local | openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Control Plane Verification
ED25519_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA... (Insert Control Plane Public Key)\n-----END PUBLIC KEY-----"

# Control Plane Service Configuration
CONTROL_PLANE_PORT=8001
DATA_PLANE_PORT=8000
